datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TrustLevel {
  HIGHLY_TRUSTED  // Score 80-100
  TRUSTED         // Score 65-79
  AVERAGE         // Score 50-64
  LOW_TRUST       // Score 30-49 (Warning state, not banned)
  UNDER_REVIEW    // Score 0-29 (Admin review required, not auto-banned)
}

enum TrustAccountStatus {
  ACTIVE
  LOW_TRUST_WARNING
  UNDER_REVIEW
  SUSPENDED_BY_ADMIN
}

enum TrustEventType {
  ORDER_COMPLETED
  DISPUTE_RAISED               // Fairness Rule: 0 penalty
  DISPUTE_UNDER_REVIEW         // Fairness Rule: 0 penalty
  DISPUTE_RESOLVED_FAVOR       // Fairness Rule: 0 penalty
  DISPUTE_FOUND_UNJUSTIFIED    // Legitimate penalty: -6
  REPEATED_UNJUSTIFIED_ABUSIVE // Progressive penalty: -12
  QUALITY_MISMATCH_CONFIRMED   // Seller penalty: -10
  ADMIN_MANUAL_ADJUSTMENT      // Logged with admin reason
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER_FAVOR
  RESOLVED_FARMER_FAVOR
  REJECTED_UNJUSTIFIED
}

enum OrderStatus {
  AWAITING_ADVANCE
  ADVANCE_PAID
  IN_TRANSIT
  DELIVERED
  CONFIRMED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED_TO_FARMER
  REFUNDED_TO_BUYER
  FAILED
}

model User {
  id                 String             @id @default(uuid())
  phone              String             @unique
  email              String?            @unique
  name               String
  role               Role               @default(FARMER)
  verificationStatus VerificationStatus @default(PENDING)
  location           String?
  kisanId            String?
  gstin              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Trust & Reputation
  trustProfile       UserTrustProfile?
  trustEvents        TrustEvent[]
  trustHistories     TrustScoreHistory[]

  // Transactions & Relationships
  farmerOrders       Order[]            @relation("FarmerOrders")
  buyerOrders        Order[]            @relation("BuyerOrders")
  disputesRaised     Dispute[]          @relation("DisputesRaised")
}

model UserTrustProfile {
  id                        String             @id @default(uuid())
  userId                    String             @unique
  score                     Int                @default(85) // Range 0 - 100
  level                     TrustLevel         @default(HIGHLY_TRUSTED)
  status                    TrustAccountStatus @default(ACTIVE)
  completedOrders           Int                @default(0)
  successfulTransactions    Int                @default(0)
  totalDisputesRaised       Int                @default(0)
  unjustifiedDisputesCount  Int                @default(0)
  positiveFactors           String[]           @default([])
  negativeFactors           String[]           @default([])
  lastCalculatedAt          DateTime           @default(now())
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrustScoreHistory {
  id            String         @id @default(uuid())
  userId        String
  previousScore Int
  newScore      Int
  delta         Int
  eventType     TrustEventType
  reason        String
  orderId       String?
  disputeId     String?
  recordedBy    String         @default("SYSTEM") // "SYSTEM" or Admin User ID
  createdAt     DateTime       @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id])
  dispute       Dispute?       @relation(fields: [disputeId], references: [id])
}

model TrustEvent {
  id          String         @id @default(uuid())
  userId      String
  eventType   TrustEventType
  scoreImpact Int            @default(0)
  description String
  orderId     String?
  disputeId   String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?         @relation(fields: [orderId], references: [id])
  dispute     Dispute?       @relation(fields: [disputeId], references: [id])
}

model Order {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique
  listingId            String
  cropTitle            String
  variety              String
  quantityQuintals     Float
  pricePerQuintal      Float
  totalAmount          Float
  advanceEscrowAmount  Float
  balanceAmount        Float
  status               OrderStatus         @default(AWAITING_ADVANCE)
  paymentStatus        PaymentStatus       @default(PENDING)
  farmerId             String
  buyerId              String
  pickupLocation       String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  farmer               User                @relation("FarmerOrders", fields: [farmerId], references: [id])
  buyer                User                @relation("BuyerOrders", fields: [buyerId], references: [id])
  disputes             Dispute[]
  trustScoreHistories  TrustScoreHistory[]
  trustEvents          TrustEvent[]
}

model Dispute {
  id                   String              @id @default(uuid())
  orderId              String
  raisedById           String
  reason               String
  description          String
  status               DisputeStatus       @default(OPEN)
  adminNotes           String?
  resolutionOutcome    String?             // e.g. "RESOLVED_BUYER_FAVOR_LEGITIMATE", "FOUND_UNJUSTIFIED"
  trustPenaltyApplied  Boolean             @default(false)
  resolvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  order                Order               @relation(fields: [orderId], references: [id])
  raisedBy             User                @relation("DisputesRaised", fields: [raisedById], references: [id])
  trustScoreHistories  TrustScoreHistory[]
  trustEvents          TrustEvent[]
}
